# ─── Upstash Redis ────────────────────────────────────────────────────────────
# Reuse the existing amusing-hippo-92821.upstash.io instance
# All keys are namespaced with bm: to avoid collisions with other projects
UPSTASH_REDIS_REST_URL=https://amusing-hippo-92821.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ─── Slack ────────────────────────────────────────────────────────────────────
# Create an Incoming Webhook in your Slack workspace:
# Slack App → Incoming Webhooks → Add New Webhook to Workspace
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK

# ─── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_KEY_HERE
ALERT_EMAIL_TO=collins.ra@northeastern.edu
ALERT_EMAIL_FROM=alerts@yourdomain.com

# ─── Dashboard Auth ───────────────────────────────────────────────────────────
# Simple shared secret for the /admin routes and /api/seed
# Generate with: openssl rand -hex 32
DASHBOARD_SECRET=REPLACE_WITH_RANDOM_SECRET
SEED_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
